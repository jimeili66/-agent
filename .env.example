# Local FastAPI backend database.
# Copy this file to .env and replace the password with your local MySQL password.
DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/live_agent?charset=utf8mb4

# Optional: enable AI-assisted product draft and host-script generation with DeepSeek.
# DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Docker Compose MySQL defaults.
MYSQL_ROOT_PASSWORD=live_agent_password
MYSQL_DATABASE=live_agent
